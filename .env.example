# ─────────────────────────────────────────────────────────────
# AYAMSMART — environment variables
# Salin ke .env.local untuk development. Jangan commit file berisi nilai asli.
# Semua variabel di bawah HANYA dipakai di server. Jangan beri prefix NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=
# Key server-side (di dashboard Supabase bernama "secret" atau "service_role").
SUPABASE_SECRET_KEY=

# PIN akses bersama untuk halaman yang mengubah data (disarankan 6 digit)
APP_PIN=
# String acak panjang untuk menandatangani cookie PIN. Ganti nilainya = semua perangkat harus input PIN lagi.
SESSION_SECRET=

# Service forecast Python (api/forecast.py)
# Lokal: jalankan `py -3.12 api\forecast.py` di terminal lain → http://127.0.0.1:8000/api/forecast
# Vercel: boleh dikosongkan (otomatis https://<domain produksi>/api/forecast)
FORECAST_URL=
# Secret bersama antara server Next.js dan fungsi Python. Wajib diisi juga di Vercel.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORECAST_SECRET=
